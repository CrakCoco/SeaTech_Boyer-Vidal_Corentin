<Window x:Class="CocoC_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CocoC_"
        mc:Ignorable="d"
        Title="MainWindow" Height="648" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Emission" Grid.Row="0" Grid.Column="0" Margin="5">
            <TextBox x:Name="textBoxEmission" KeyUp="TextBoxEmission_KeyUp"></TextBox>
        </GroupBox>
        <GroupBox Grid.Column="1" Header="GroupBox" Grid.Row="0" Margin="5">
            <TextBox x:Name="textBoxReception"></TextBox>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <Button x:Name="buttonEnvoyer" Content="Send" Width="120" Margin="5" Click="buttonEnvoyer_Click"/>
            <Button x:Name="buttonClear" Content="Clear" Width="120" Margin="5"/>
        </StackPanel>   
    </Grid>
</Window>
